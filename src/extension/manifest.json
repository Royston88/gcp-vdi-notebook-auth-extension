{
  "manifest_version": 3,
  "name": "Workbench Token Helper Extension",
  "version": "1.0",
  "description": "Intercepts requests to Google Cloud Workbench and adds auth headers.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "nativeMessaging",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.googleusercontent.com/*",
    "*://*.cloud.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.notebooks.googleusercontent.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "key": ""
}